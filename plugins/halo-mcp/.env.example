# Halo Cross-Media Measurement API — environment configuration.
# Get these 6 values from your Halo Kingdom operator.

# Halo Reporting API base URL
HALO_BASE_URL=https://api.<your-deployment>.example.com

# Your measurementConsumer resource name
HALO_MC_ID=measurementConsumers/<your-id>

# Auth0 tenant URL (OAuth2 client-credentials grant)
HALO_AUTH0_URL=https://<tenant>.auth0.com

# Auth0 audience identifier (your Halo API)
HALO_AUTH0_AUDIENCE=https://<your-api-identifier>

# OAuth2 client credentials (KEEP SECRET — don't commit)
HALO_CLIENT_ID=
HALO_CLIENT_SECRET=

# Optional: outbound HTTP proxy (set only if your network requires it)
# HTTPS_PROXY=http://proxy.example.com:8080

# Optional: token cache file (default: ~/.halo_token, mode 600)
# HALO_TOKEN_FILE=

# Optional: where export_basic_report writes .pptx files (default: ~/Downloads)
# HALO_EXPORT_DIR=

# Optional: HTTP transport port (default: 3001). Ignored under --stdio.
# PORT=3001
