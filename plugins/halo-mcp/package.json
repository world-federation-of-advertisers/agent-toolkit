{
  "name": "halo-mcp",
  "version": "0.1.0",
  "description": "MCP server + interactive React UI for the Halo Cross-Media Measurement API (WFA)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:ui": "cross-env INPUT=mcp-app.html vite build",
    "build:server": "esbuild main.ts --bundle --platform=node --target=node20 --format=esm --packages=external --banner:js='#!/usr/bin/env node' --outfile=dist/server/main.mjs",
    "build": "npm run typecheck && npm run build:ui && npm run build:server",
    "serve": "tsx main.ts",
    "serve:stdio": "tsx main.ts --stdio",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node scripts/run-tests.mjs test/unit",
    "test:e2e": "node scripts/run-tests.mjs test/e2e",
    "dev": "cross-env NODE_ENV=development concurrently 'cross-env INPUT=mcp-app.html vite build --watch' 'tsx --watch main.ts'",
    "start": "npm run build && npm run serve",
    "build:mcpb": "npm run build && bash scripts/build-mcpb.sh",
    "pack": "npm run build && npm pack"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "halo-mcp": "dist/server/main.mjs"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.6",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "express": "^5.2.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "undici": "^6.26.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
