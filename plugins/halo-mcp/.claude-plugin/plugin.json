{
  "name": "halo-mcp",
  "version": "0.1.0",
  "description": "MCP server + interactive React UI for the Halo Cross-Media Measurement API",
  "author": {
    "name": "World Federation of Advertisers",
    "url": "https://github.com/world-federation-of-advertisers"
  },
  "homepage": "https://github.com/world-federation-of-advertisers/cross-media-measurement",
  "license": "Apache-2.0",
  "keywords": [
    "halo",
    "cross-media-measurement",
    "mcp",
    "reporting",
    "wfa"
  ],
  "mcpServers": {
    "halo": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/server/main.mjs",
        "--stdio"
      ],
      "env": {
        "HALO_BASE_URL": "${HALO_BASE_URL}",
        "HALO_MC_ID": "${HALO_MC_ID}",
        "HALO_AUTH0_URL": "${HALO_AUTH0_URL}",
        "HALO_AUTH0_AUDIENCE": "${HALO_AUTH0_AUDIENCE}",
        "HALO_CLIENT_ID": "${HALO_CLIENT_ID}",
        "HALO_CLIENT_SECRET": "${HALO_CLIENT_SECRET}"
      }
    }
  }
}
